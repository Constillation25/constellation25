{
  "name": "C25 Sovereign Workspace",
  "dockerFile": "Dockerfile",
  "remoteUser": "node",
  "mounts": [
    "source=${localEnv:HOME},target=/workspace/host_home,type=bind,readonly"
  ],
  "postCreateCommand": "echo 'Host home mounted at /workspace/host_home'",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
